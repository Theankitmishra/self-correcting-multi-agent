# ==============================================================================
# Self-Correcting Multi-Agent System - Environment Configuration
# ==============================================================================

# LLM Provider Choice: "openai" | "digitalocean" | "groq"
LLM_PROVIDER=openai

# 1. OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# 2. DigitalOcean Serverless GenAI Configuration (Optional)
DO_INFERENCE_BASE_URL=https://inference.do-ai.run/v1
MODEL_ACCESS_KEY=your_digitalocean_model_access_key_here
DO_MODEL=kimi-k3
DO_INFERENCE_ROUTER=

# 3. Groq Ultra-Fast Inference Configuration (Optional)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Multi-Agent Workflow Parameters
MAX_REVISIONS=3
TEMPERATURE=0.2
QUALITY_THRESHOLD=0.85
PORT=8000
